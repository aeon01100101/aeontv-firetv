<?xml version="1.0" encoding="utf-8"?>
<!-- Focusable card background for the AeonTV TV screens: accent ring when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2E1A4D" />
            <stroke android:width="6dp" android:color="#00C8F0" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2E1A4D" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#241239" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
